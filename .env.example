APP_NAME=Production AI Workflow Platform
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_API_HOST=0.0.0.0
APP_API_PORT=8000
APP_DATABASE_URL=postgresql+psycopg://platform:platform@postgres:5432/platform
APP_DATABASE_CONNECT_TIMEOUT_SECONDS=3
APP_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
APP_KAFKA_TOPIC=platform.events
EVENT_WORKER_GROUP_ID=platform-event-worker-v1
EVENT_WORKER_DLQ_TOPIC=platform.events.dlq

